{
    "name": "mdcn-demo",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@openzeppelin/contracts": "^5.6.1",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^14.6.13",
        "ethers": "^6.17.0",
        "react": "^18.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.6",
        "react-scripts": "5.0.1",
        "web-vitals": "^6.2.3",
        "sass": "^1.108.2"
    },
    "scripts": {
        "start": "react-scripts start",
        "build": "react-scripts build",
        "test": "react-scripts test",
        "eject": "react-scripts eject",
        "start:all": "npx concurrently \"npm run dev\" \"npm start\"",
        "demo": "npx hardhat run --network localhost scripts/demo-seed.js",
        "dev": "node scripts/hardhat-setup.js",
        "hardhat:node": "hardhat node",
        "hardhat:config": "hardhat generate-config --limit 10",
        "hardhat:deploy": "hardhat run --network localhost scripts/deploy.js",
        "hardhat:update": "hardhat update-app-config",
        "hardhat:kill": "node scripts/kill-port.js 8545",
        "hardhat:accounts": "hardhat accounts",
        "simulate:hierarchy": "hardhat run --network localhost scripts/push-all-hierarchy.js"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@nomiclabs/hardhat-ethers": "^2.2.3",
        "@nomiclabs/hardhat-waffle": "^2.0.6",
        "chai": "^6.3.0",
        "ethereum-waffle": "^4.0.10",
        "hardhat": "^3.22.0"
    }
}
